# Copy to .env before first run. The API and worker refuse to start
# without a session secret of at least 32 characters.

CTF_WORKBENCH_SESSION_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
CTF_WORKBENCH_DATA_ROOT=./data
CTF_WORKBENCH_DATABASE_URL=sqlite:///./data/workbench.db
CTF_WORKBENCH_BIND_HOST=127.0.0.1
CTF_WORKBENCH_BIND_PORT=8745
CTF_WORKBENCH_LOG_LEVEL=INFO
CTF_WORKBENCH_DOCKER_HOST=
CTF_WORKBENCH_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CTF_WORKBENCH_ALLOW_NONLOCAL_BIND=false
